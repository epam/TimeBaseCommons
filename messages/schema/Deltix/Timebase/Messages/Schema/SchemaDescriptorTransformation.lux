namespace Deltix.Timebase.Messages.Schema;

import Deltix.Timebase.Messages.*;

/// Class which defines a transformation that is applied to the descriptor.
[SchemaElement(Name = "deltix.timebase.messages.schema.SchemaDescriptorTransformation", Title = "SchemaDescriptorTransformation")]
[GenerateReadOnlyInterface][GenerateReadWriteInterface]
class SchemaDescriptorTransformation {

    /// Defines the transformation type that was applied to the descriptor.
    [SchemaElement]
    [SchemaType(IsNullable=false)]
    SchemaDescriptorTransformationType TransformationType;
}
