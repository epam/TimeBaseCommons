namespace Deltix.Timebase.Messages.Schema;

import Deltix.Timebase.Messages.*;

/// Schema definition for a class.
[SchemaElement(Name = "deltix.timebase.api.messages.schema.RecordClassDescriptor", Title = "RecordClassDescriptor")]
[GenerateReadOnlyInterface][GenerateReadWriteInterface]
class RecordClassDescriptor : ClassDescriptor {

    /// List of fields of a class.
    [SchemaElement]
    [SchemaArrayType(IsNullable = false, IsElementNullable = false,
        ElementTypes = { typeof(DataField) })]
    List<DataField> DataFields;
}
