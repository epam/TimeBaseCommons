namespace Deltix.Timebase.Messages.Schema;

import Deltix.Timebase.Api.*;


/// Type of transformation applied to data field.
[SchemaElement(Name = "deltix.timebase.messages.schema.SchemaFieldDataTransformationType", Title = "SchemaFieldDataTransformationType")]
enum SchemaFieldDataTransformationType {
    /// Convert data operation.
    [SchemaElement(Name = "CONVERT_DATA")]
    CONVERT_DATA = 0;
    /// Apply default value operation.
    [SchemaElement(Name = "SET_DEFAULT")]
    SET_DEFAULT = 1;
    /// Drop record operation.
    [SchemaElement(Name = "DROP_RECORD")]
    DROP_RECORD = 2;
}
